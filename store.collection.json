        {
          "name": "Test sorting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 for sorting\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Users are sorted by firstName ASC\", function() {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.be.an('array');\r",
                  "    \r",
                  "    var receivedNames = jsonData.map(u => String(u.firstName || \"\"));\r",
                  "    // Точная копия сортировки сервера без toLowerCase()\r",
                  "    var sortedNames = [...receivedNames].sort((a, b) => a < b ? -1 : (a > b ? 1 : 0));\r",
                  "    \r",
                  "    for (var i = 0; i < receivedNames.length; i++) {\r",
                  "        pm.expect(receivedNames[i]).to.equal(sortedNames[i]);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
